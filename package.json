{
  "name": "dsh-connect-modelscope-token-plan",
  "displayName": "DSH Connect ModelScope Token Plan",
  "icon": "./icon.svg",
  "version": "0.6.5",
  "homepage": "https://github.com/eghrhegpe/dsh-connect-modelscope-token-plan",
  "bugs": {
    "url": "https://github.com/eghrhegpe/dsh-connect-modelscope-token-plan/issues"
  },
  "author": "eghrhegpe",
  "description": "One-tap connect ModelScope language and image-generation models into DSH (off by default), with image recognition and context window filled in automatically. You can also see the free Magicube balance, jump to a model's info page, and record local call counts, trends and rate-limit events, with a usage pill beside the input box showing the balance and today's local count. All of it needs only an API key, with no account sign-in.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "modelscope",
    "token-plan",
    "quota",
    "api-inference"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "icon.svg",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "screenshots.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:client": "tsdown -c tsdown.config.mjs",
    "duplicate-check": "jscpd src --min-tokens 70 --reporters console-full",
    "test": "node test/run-all.mjs",
    "test:mutate": "node tools/dev/mutate.mjs tools/dev/mutate-spec.json",
    "doctor": "node tools/doctor.mjs",
    "doctor:json": "node tools/doctor.mjs --json",
    "host-range:update": "node tools/update-host-range.mjs",
    "host-range:check": "node tools/update-host-range.mjs --check",
    "market-rules:update": "node tools/check-market-rules.mjs",
    "market-rules:check": "node tools/check-market-rules.mjs --check",
    "build": "tsdown -c tsdown.config.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-credentials": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-llm": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-settings": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-tools": ">=0.1.5 <0.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": ">=0.85.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eghrhegpe/dsh-connect-modelscope-token-plan.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.19.0",
    "js-yaml": "^5.3.0",
    "jscpd": "^5.4.0",
    "jsdom": "^30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "rolldown": "1.2.12",
    "rolldown-plugin-dts": "0.28.6"
  }
}
