        "from": "    timeoutMs: waitMs + 10_000,",
        "to": "    timeoutMs: timeoutMs + 10_000,"
      }
    ]
  },
  {
    "target": "src/host/draw-jobs.ts",
    "test": "draw-jobs.test.mjs",
    "mutants": [
      {
        "name": "容量满了不淘汰（长跑会话把内存慢慢养成泄漏）",
        "from": "    while (jobs.size > maxJobs) {",
        "to": "    while (false) {"
      },
      {
        "name": "get 返回表内引用（外部改动能污染表）",
        "from": "      return found === undefined ? null : { ...found };",
        "to": "      return found === undefined ? null : found;"
      },
      {
        "name": "notePolls 改赋值（跨调用累计的轮询数被清零）",
