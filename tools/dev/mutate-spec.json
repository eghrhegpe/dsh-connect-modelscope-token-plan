[
  {
    "target": "src/client/snapshot.ts",
    "test": "snapshot.test.mjs",
    "mutants": [
      {
        "name": "删掉 modelCount 的 Number.isFinite 检查（NaN 会渲成「NaN 个模型」）",
        "from": "typeof p.modelCount === \"number\" && Number.isFinite(p.modelCount)",
        "to": "typeof p.modelCount === \"number\""
      },
      {
        "name": "删掉 enabledCount 的 Number.isFinite 检查",
        "from": "typeof p.enabledCount === \"number\" && Number.isFinite(p.enabledCount)",
        "to": "typeof p.enabledCount === \"number\""
      }
    ]
  },
  {
    "target": "src/client/const.ts",
    "test": "snapshot.test.mjs",
    "mutants": [
      {
        "name": "encodeURI 不转义 #/?，模型 id 含这些字符时 URL 语义被破坏",
        "from": "id.split(\"/\").map(encodeURIComponent).join(\"/\")",
        "to": "encodeURI(id)"
      }
    ]
  },
  {
    "target": "src/host/publish-core.ts",
    "test": "provider-publish.test.mjs",
    "mutants": [
      {
        "name": "删掉 restorePreviousPair 调用（注册失败后旧对不会被恢复）",
        "from": "    restorePreviousPair({ llm, previousBuilt, state, registerPair, release });",
        "to": "    // restorePreviousPair removed"
      }
    ]
  },
  {
    "target": "src/host/provider-publish.ts",
    "test": "provider-publish.test.mjs",
    "mutants": [
      {
        "name": "开侧空转守卫恒为 false（每次 publish 都重建 provider）",
        "from": "    if (phaseOf(false) === \"serving\" && offerUnchanged()) {",
        "to": "    if (phaseOf(false) === \"serving\" && false) {"
      },
      {
        "name": "删掉 disposed 第二次闸门检查（teardown 与 publish 竞态 → 僵尸 provider）",
        "from": "    if (queue.isDisposed()) return { ok: false, skipped: true };\n    // swap（连同背后的 rollback）是共享机制：失败的重新注册必须恢复先前在服务的对。",
        "to": "    // ── 闸门第二次检查已移除 ──\n    // swap（连同背后的 rollback）是共享机制：失败的重新注册必须恢复先前在服务的对。"
      },
      {
        "name": "disposed 不再压过一切（dispose 后相位被报成 idle，守卫会放行 publish → 僵尸 provider）",
        "from": "  if (disposed) return \"disposed\";",
        "to": "  if (disposed) return \"idle\";"
      },
      {
        "name": "failing 相位消失（回滚态误判为已服务 → 空转守卫跳过重试，静默丢弃用户刚保存的清单）",
        "from": "  if (state.registered) return state.error === null ? \"serving\" : \"failing\";",
        "to": "  if (state.registered) return \"serving\";"
      }
    ]
  },
  {
    "target": "src/shared/allow-list.ts",
    "test": "allow-list.test.mjs",
    "mutants": [
      {
        "name": "哨兵检查消失（[哨兵, \"a/A\"] 混排被当白名单 → 同一个清单有两个答案）",
        "from": "  if (enabledIds.includes(HIDE_ALL_MODELS)) return { mode: \"none\" };",
        "to": "  // sentinel check removed"
      },
      {
        "name": "空清单判成 none（新装默认变成「什么都不提供」）",
        "from": "  if (!Array.isArray(enabledIds) || enabledIds.length === 0) return { mode: \"all\" };",
        "to": "  if (!Array.isArray(enabledIds) || enabledIds.length === 0) return { mode: \"none\" };"
      },
      {
        "name": "「全部隐藏」的 enabledCount 数成 roster 全长（面板撒谎：显示全启用，实际提供 0）",
        "from": "    case \"all\":\n      return rosterIds.length;\n    case \"none\":\n      return 0;",
        "to": "    case \"all\":\n      return rosterIds.length;\n    case \"none\":\n      return rosterIds.length;"
      }
    ]
  },
  {
    "target": "src/host/draw-runtime.ts",
    "test": "draw-runtime.test.mjs",
    "mutants": [
      {
