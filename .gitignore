# 凭据与本机状态：绝不进版本库
.env
.env.*
*.env
# 运行时产物
*.log
logs/
tmp/

# 会话工具状态
.zcode/
.agnes/
.box-agent/

# 依赖与构建
node_modules/
package-lock.json
dist/
build/
.build/
*.tsbuildinfo
# npm pack 的产物（本地打包验证用），不应进版本库
*.tgz

# lib/ 与根 client.js 是**构建产物、不入库**（与兄弟插件 sensenova/agnes 同款决策）：
# DSH 市场的 github: 安装源走 pnpm git-dep，pnpm 对 git 依赖只在 allowBuilds 批准后
# 跑 prepare（未批准报 ERR_PNPM_GIT_DEP_PREPARE_NOT_ALLOWED，并打印要加的那行）——
# 产物由 prepare 在安装/发布时现场重建，不需要提交进仓；批准步骤见 README 安装节。
# test/build-gate.mjs 仍校验「client.js 是 src 的忠实重建 + 切分闭包」，与是否入库无关。
lib/
client.js

# build-gate 跑完即删的临时构建配置（防御性忽略：万一中途被强杀，残留物不该
# 进版本库也不该让人困惑）。
.build-gate.config.mjs

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 上游参考仓库容器（各子目录自带 .git，仅本地容纳、绝不进本仓库历史）
/upstream/
